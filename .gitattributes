# Normalise line endings in the repository; check out native on each platform.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.props     text
*.targets   text
*.sln       text eol=crlf
*.md        text
*.json      text
*.yml       text
*.yaml      text
*.ts        text
*.tsx       text
*.css       text
*.html      text

*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.sh        text eol=lf

*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
