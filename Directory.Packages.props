<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    One place for every package version. See artifacts/design/06-tech-stack.md.
    If this list passes ~20 entries, something was added that was not needed.
  -->
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Registers the DbContext from the connection string the AppHost injects,
         with health checks, retries and telemetry attached. -->
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6" />
    <!-- snake_case tables and columns. EF Core 10 has no built-in convention, and unquoted
         lowercase identifiers are what makes the database pleasant to query by hand in pgweb. -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <!-- .NET 10 generates the OpenAPI document in-box; no Swashbuckle. -->
  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Transitive pin. Microsoft.AspNetCore.OpenApi 10.0.10 drags in Microsoft.OpenApi 2.0.0,
      which carries a known high-severity advisory (GHSA-v5pm-xwqc-g5wc). Caught by
      NU1903 under TreatWarningsAsErrors. Remove this pin once the parent package
      references a patched version itself.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <!-- Document viewer for Development. Microsoft.AspNetCore.OpenApi ships MapOpenApi only —
         there is no built-in UI. Scalar is free, OSS and reads the generated document. -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.18" />
  </ItemGroup>

  <ItemGroup Label="Extensions">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <!-- Local orchestration only. Nothing here is deployed — see 01-architecture.md §7.3. -->
  <ItemGroup Label="Aspire hosting">
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.4.6" />
    <!-- Aspire 13's JS hosting. Aspire.Hosting.NodeJs stopped at 9.5.2 and has no 13.x. -->
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.4.6" />
  </ItemGroup>

  <!-- Consumed by Lms.ServiceDefaults. Same instrumentation locally and in Azure;
       only the OTLP destination differs. See 06-tech-stack.md §3.1. -->
  <ItemGroup Label="Observability and resilience">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Shouldly, not FluentAssertions: v8+ of the latter is commercially licensed. -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- The maintained fork; NetArchTest.Rules itself has been dormant since 1.3.2.
         Assertion-library agnostic, so xunit v3 is a non-issue. -->
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
  </ItemGroup>

</Project>
